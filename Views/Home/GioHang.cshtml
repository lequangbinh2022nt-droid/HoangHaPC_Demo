@model List<HoangHaPC_Demo.Models.CartItem>
@{
    Layout = null;
    var vn = new System.Globalization.CultureInfo("vi-VN");
    long tongTien = Model.Sum(x => x.ThanhTien);
    int tongSoLuong = Model.Sum(x => x.SoLuong);
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Giỏ hàng - HoangHaPC</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/Style.css" rel="stylesheet" />

    <style>
        body {
            background-color: #e8eef8;
        }

        .cart-page {
            max-width: 1340px;
            margin: 0 auto;
            padding: 20px 16px 50px;
        }

        /* ===== BREADCRUMB ===== */
        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: #333;
        }

            .breadcrumb a {
                color: #1565c0;
                text-decoration: none;
                background: #fff;
                border: 1px solid #d5e2f5;
                padding: 5px 12px;
                border-radius: 20px;
            }

                .breadcrumb a i {
                    margin-right: 4px;
                }

            .breadcrumb .sep {
                color: #999;
            }

        .cart-title {
            color: #0b4fae;
            font-size: 28px;
            font-weight: 700;
            margin: 22px 0 20px;
        }

        /* ===== THÔNG BÁO ===== */
        .cart-alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 600;
        }

            .cart-alert.success {
                background: #dcfce7;
                color: #166534;
                border: 1px solid #86efac;
            }

            .cart-alert.error {
                background: #fee2e2;
                color: #991b1b;
                border: 1px solid #fca5a5;
            }

        /* ===== BỐ CỤC 2 CỘT ===== */
        .cart-layout {
            display: grid;
            grid-template-columns: 1fr 370px;
            gap: 20px;
            align-items: start;
        }

        .cart-box {
            background: #fff;
            border-radius: 10px;
            padding: 16px 14px;
            margin-bottom: 12px;
        }

            .cart-box form {
                margin: 0;
            }

        /* ===== THANH TRÊN ===== */
        .cart-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .cart-top span {
                font-size: 15px;
                font-weight: 600;
                color: #222;
            }

        .btn-outline {
            background: #fff;
            color: #1565c0;
            border: 1px solid #1565c0;
            border-radius: 20px;
            padding: 9px 20px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

            .btn-outline:hover {
                background: #1565c0;
                color: #fff;
            }

        /* ===== TỪNG SẢN PHẨM ===== */
        .cart-item {
            display: grid;
            grid-template-columns: 74px 1fr 100px 160px 40px;
            align-items: center;
            gap: 14px;
        }

            .cart-item img {
                width: 74px;
                height: 74px;
                object-fit: contain;
                border: 1px solid #e3e8f0;
                border-radius: 4px;
            }

        .ci-name {
            display: block;
            color: #1a1a1a;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            line-height: 1.35;
        }

        .ci-unit {
            display: block;
            margin-top: 6px;
            color: #666;
            font-size: 12px;
        }

        .ci-qty {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f1f3f7;
            border-radius: 20px;
            padding: 4px 6px;
        }

            .ci-qty button {
                width: 26px;
                height: 26px;
                border: none;
                background: transparent;
                color: #666;
                font-size: 16px;
                cursor: pointer;
                border-radius: 50%;
            }

                .ci-qty button:hover {
                    background: #dfe6f2;
                    color: #1565c0;
                }

            .ci-qty span {
                font-size: 14px;
                font-weight: 600;
            }

        .ci-price {
            text-align: center;
            color: #e53935;
            font-size: 15px;
            font-weight: 700;
        }

        .ci-del {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid #f3c2c2;
            background: #fff5f5;
            color: #e53935;
            font-size: 15px;
            cursor: pointer;
        }

            .ci-del:hover {
                background: #e53935;
                color: #fff;
            }

        /* ===== GIỎ TRỐNG ===== */
        .cart-empty {
            text-align: center;
            padding: 40px 14px;
            color: #666;
        }

            .cart-empty i {
                font-size: 56px;
                color: #b7c8e4;
                margin-bottom: 12px;
            }

            .cart-empty a {
                display: inline-block;
                margin-top: 14px;
                background: #1565c0;
                color: #fff;
                padding: 10px 22px;
                border-radius: 20px;
                text-decoration: none;
                font-weight: 600;
            }

        /* ===== THÔNG TIN ĐƠN HÀNG ===== */
        .cart-summary h3 {
            font-size: 16px;
            color: #222;
            margin-bottom: 14px;
        }

        .sum-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
            color: #333;
        }

            .sum-row b {
                font-size: 16px;
                text-decoration: underline;
            }

        .sum-final {
            border-top: 1px dashed #d5d9e0;
            margin-top: 14px;
            padding-top: 14px;
            font-size: 13px;
        }

            .sum-final i {
                color: #999;
                margin-right: 6px;
            }

            .sum-final b {
                color: #e53935;
                font-size: 19px;
            }

        /* ===== FORM NHẬN HÀNG ===== */
        .cart-right {
            padding: 20px 16px;
        }

            .cart-right h3 {
                color: #0b4fae;
                font-size: 16px;
                margin-bottom: 6px;
            }

            .cart-right .note {
                font-size: 12px;
                color: #444;
                line-height: 1.5;
                margin-bottom: 14px;
            }

                .cart-right .note a {
                    color: #1565c0;
                    text-decoration: none;
                    font-weight: 600;
                }

        .cart-form input, .cart-form textarea {
            width: 100%;
            border: 1px solid transparent;
            background: #eef1f6;
            border-radius: 8px;
            padding: 13px 14px;
            font-size: 14px;
            margin-bottom: 12px;
            outline: none;
            font-family: inherit;
        }

            .cart-form input:focus, .cart-form textarea:focus {
                border-color: #1e88ff;
                background: #fff;
            }

        .cart-form textarea {
            height: 90px;
            resize: vertical;
        }

        .cart-form .hint {
            font-size: 12px;
            color: #555;
            margin: -6px 0 14px;
        }

            .cart-form .hint i {
                color: #1565c0;
                margin-right: 4px;
            }

        .btn-order {
            width: 100%;
            border: none;
            border-radius: 26px;
            padding: 14px;
            cursor: pointer;
            background: linear-gradient(90deg, #1e88ff, #0b4fae);
            color: #fff;
            font-size: 16px;
            font-weight: 700;
        }

            .btn-order:hover {
                opacity: .9;
            }

            .btn-order:disabled {
                background: #b7c3d6;
                cursor: not-allowed;
            }

        @@media (max-width: 992px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 600px) {
            .cart-item {
                grid-template-columns: 64px 1fr 40px;
            }

                .cart-item img {
                    width: 64px;
                    height: 64px;
                }

            .ci-qty {
                grid-column: 2;
                width: 110px;
            }

            .ci-price {
                grid-column: 2;
                text-align: left;
            }

            .cart-item > form:last-child {
                grid-row: 1;
                grid-column: 3;
            }
        }
    </style>

    <!-- ===== JAVASCRIPT CƠ BẢN (theo Chương 4) ===== -->
    <script language="Javascript">

            // Hàm kiểm tra form đặt hàng trước khi gửi về server
            // frm = form được truyền vào từ onsubmit="return kiemTraDatHang(this)"
            function kiemTraDatHang(frm) {
                var hoTen  = frm.hoTen.value;
                var sdt    = frm.soDienThoai.value;
                var email  = frm.email.value;
                var diaChi = frm.diaChi.value;

                // Mẫu số điện thoại: bắt đầu bằng 0, theo sau là 9 chữ số
                var mauSDT = /^0\d{9}$/;

                if (hoTen == '') {
                    alert('Vui lòng nhập Họ và tên!');
                    frm.hoTen.focus();
                    return false;
                }

                if (mauSDT.test(sdt) == false) {
                    alert('Số điện thoại phải gồm 10 số và bắt đầu bằng số 0!');
                    frm.soDienThoai.focus();
                    return false;
                }

                if (email != '' && email.indexOf('@@') == -1) {
                    alert('Email không hợp lệ (thiếu ký tự @@)!');
                    frm.email.focus();
                    return false;
                }

                if (diaChi == '') {
                    alert('Vui lòng nhập Địa chỉ nhận hàng!');
                    frm.diaChi.focus();
                    return false;
                }

                return confirm('Xác nhận đặt hàng cho ' + hoTen + '?');
            }

    </script>
</head>
<body>
    <div class="cart-page">

        <!-- ===== BREADCRUMB ===== -->
        <div class="breadcrumb">
            <a href="/Home/HoangHaPC"><i class="fa-solid fa-house"></i>Trang chủ</a>
            <span class="sep">»</span>
            <span>Thông tin giỏ hàng</span>
        </div>

        <h1 class="cart-title">Giỏ hàng của tôi</h1>

        <!-- ===== THÔNG BÁO TỪ SERVER ===== -->
        @if (TempData["ThongBao"] != null)
        {
            <div class="cart-alert success"><i class="fa-solid fa-square-check"></i> @TempData["ThongBao"]</div>
        }
        @if (ViewBag.Loi != null)
        {
            <div class="cart-alert error"><i class="fa-solid fa-rectangle-xmark"></i> @ViewBag.Loi</div>
        }

        <div class="cart-layout">

            <!-- ===== CỘT TRÁI ===== -->
            <div class="cart-left">

                <div class="cart-box cart-top">
                    <span>@tongSoLuong sản phẩm</span>
                    @if (Model.Count > 0)
                    {
                        <form action="/Home/XoaHet" method="post">
                            <button type="submit" class="btn-outline"
                                    onclick="return confirm('Bạn có chắc muốn xóa TOÀN BỘ giỏ hàng?')">
                                LÀM TRỐNG GIỎ HÀNG
                            </button>
                        </form>
                    }
                </div>

                @if (Model.Count == 0)
                {
                    <div class="cart-box cart-empty">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <p>Giỏ hàng của bạn đang trống</p>
                        <a href="/Home/HoangHaPC">Tiếp tục mua sắm</a>
                    </div>
                }

                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];

                    <div class="cart-box cart-item">
                        <img src="@item.Hinh" alt="@item.Ten" />

                        <div>
                            <span class="ci-name">@item.Ten</span>
                            <span class="ci-unit">Đơn giá: @item.Gia.ToString("N0", vn) đ</span>
                        </div>

                        <div class="ci-qty">
                            <form action="/Home/GiamSoLuong" method="post">
                                <input type="hidden" name="viTri" value="@i" />
                                <button type="submit">−</button>
                            </form>
                            <span>@item.SoLuong</span>
                            <form action="/Home/TangSoLuong" method="post">
                                <input type="hidden" name="viTri" value="@i" />
                                <button type="submit">+</button>
                            </form>
                        </div>

                        <div class="ci-price">@item.ThanhTien.ToString("N0", vn) đ</div>

                        <form action="/Home/XoaSanPham" method="post">
                            <input type="hidden" name="viTri" value="@i" />
                            <button type="submit" class="ci-del" title="Xóa sản phẩm"
                                    onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
                                <i class="fa-regular fa-trash-can"></i>
                            </button>
                        </form>
                    </div>
                }

                <div class="cart-box cart-summary">
                    <h3>Thông tin đơn hàng</h3>
                    <div class="sum-row">
                        <span>Tổng tiền</span>
                        <b>@tongTien.ToString("N0", vn) đ</b>
                    </div>
                    <div class="sum-row sum-final">
                        <span><i class="fa-regular fa-credit-card"></i>Tổng thanh toán</span>
                        <b>@tongTien.ToString("N0", vn) đ</b>
                    </div>
                </div>
            </div>

            <!-- ===== CỘT PHẢI: THÔNG TIN NHẬN HÀNG ===== -->
            <div class="cart-box cart-right">
                <h3>Thông tin nhận hàng</h3>
                <p class="note">
                    Để tiếp tục đặt hàng, quý khách xin vui lòng <a href="#">đăng nhập</a> hoặc nhập thông tin bên dưới.
                    Tư vấn viên sẽ liên hệ theo thông tin bạn cung cấp để xác nhận, không mua không sao.
                </p>

                <form name="frmDatHang" action="/Home/DatHang" method="post" class="cart-form"
                      onsubmit="return kiemTraDatHang(this)">
                    <input type="text" name="hoTen" placeholder="Họ và tên" value="@ViewBag.HoTen" />
                    <input type="text" name="soDienThoai" placeholder="Số điện thoại" value="@ViewBag.SoDienThoai" />
                    <input type="text" name="email" placeholder="Nhập email" value="@ViewBag.Email" />
                    <input type="text" name="diaChi" placeholder="Địa chỉ nhận hàng" value="@ViewBag.DiaChi" />
                    <p class="hint"><i class="fa-solid fa-circle-info"></i>Nhập Số nhà, Đường, Phường/xã, Quận, Tỉnh</p>
                    <textarea name="ghiChu" placeholder="Ghi chú">@ViewBag.GhiChu</textarea>

                    @if (Model.Count > 0)
                    {
                        <button type="submit" class="btn-order">ĐẶT HÀNG</button>
                    }
                    else
                    {
                        <button type="button" class="btn-order" disabled>ĐẶT HÀNG</button>
                    }
                </form>
            </div>

        </div>
    </div>
</body>
</html>